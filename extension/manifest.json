{
  "manifest_version": 3,
  "name": "My Kitchen Notes — Save recipes from any site",
  "short_name": "My Kitchen Notes",
  "version": "1.6.1",
  "description": "Save recipes from any website, and from Facebook, Instagram and TikTok posts, into your My Kitchen Notes collection.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Send this page’s recipe to My Kitchen Notes (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "config.js",
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "APP_PAGES"
      ],
      "js": [
        "config.js",
        "appmark.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Send this page’s recipe to My Kitchen Notes"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/32.png"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*"
      ]
    }
  ]
}
