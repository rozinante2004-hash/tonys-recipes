  OWN --> LIVE
  OWN --> TEST
  NEW -.-> LIVE
  LIVE --- LS
  LIVE --- IDB
  LIVE --> BK

  REPO -- "push main → deploy" --> LIVE
  REPO -- "push test → build" --> TEST
  REPO --> CI
  RREPO --> ROOT

  LIVE -- "sign-in" --> ROOT
  ROOT --> FLA
  TEST -- "sign-in (own address)" --> FTA
  FLA --- OAUTH
  LIVE --> FLD
  LIVE --> FLI
  TEST --> FTA
  TEST -- "languages" --> FLI
  NEW -.-> FLI
  FLD -. "🏠 copy (move)" .-> FLH

  LIVE --> W
  TEST --> W
  W --> AI
  W --> PH
  W --> YT
  W --> BR
  LIVE --> GM
  LIVE --> GHAPI

