flowchart TB
  %% Tony's Recipes — every site, service and function, and how they connect (v36.88)
  subgraph PEOPLE["👥 People & devices"]
    direction LR
    FAM["📱💻 Family phones & PCs<br/>(installed app or browser)"]
    OWN["👑 Tony — owner<br/>Self Test · Deployments · rules"]
    NEW["🆕 Visitors / new users<br/>(public, later)"]
  end

  subgraph DEVICE["📦 On each device"]
    direction LR
    LS["localStorage<br/>recipes · settings · one language"]
    IDB["IndexedDB<br/>photos · AI cache"]
    BK["💾 Backups<br/>file or chosen folder, daily<br/>recipes + photos + languages"]
  end

  subgraph SITES["🌐 Websites"]
    direction LR
    LIVE["🏠 FAMILY APP<br/>rozinante2004-hash.github.io/tonys-recipes/<br/>GitHub Pages · branch main"]
    ROOT["🔑 SITE ROOT<br/>rozinante2004-hash.github.io/<br/>/__/auth/ Google sign-in pages · 404 → app"]
    TEST["🧪 TEST COPY<br/>tonys-recipes-test.pages.dev<br/>Cloudflare Pages · branch test<br/>orange TEST marking · Bring! off"]
  end

  subgraph CODE["🗂 GitHub — code & automation"]
    direction LR
    REPO["repo tonys-recipes<br/>test → (Tony's OK) → main"]
    CI["⚙️ CI — Self Tests on every push<br/>~290 checks × 4 profiles · test build<br/>rules + households rules (emulator)<br/>end-to-end sync, both layouts (emulator)<br/>Worker · contrast · phone · accessibility"]
    RREPO["repo rozinante2004-hash.github.io<br/>weekly: fetch sign-in files"]
  end

  subgraph CF["☁️ Cloudflare"]
    direction LR
    W["🛡 Worker lively-bread-273a (v41)<br/>app key · allowed sites · spending limits<br/>(pasted by hand)"]
  end

  subgraph APIS["🔌 Services the Worker calls"]
    direction LR
    AI["🤖 Claude — import, translate,<br/>nutrition, suggestions, help"]
    PH["🖼 Photos — Openverse · Pixabay<br/>Pexels · Unsplash"]
    YT["▶️ YouTube · Instagram · web pages<br/>(recipe import)"]
    BR["🛒 Bring! shopping list"]
  end

  subgraph FB["🔥 Firebase / Google Cloud"]
    direction LR
    FLA["project recipes-f379d — FAMILY<br/>Google sign-in (Auth)"]
    FLD["Firestore — shared/*<br/>recipes · photos · chats · meta · backups · members"]
    FLI["🌍 Languages — shared/i18n_*<br/>CENTRAL for every copy & user<br/>(anyone reads · admins write)"]
    FLH["🏘 households/* — WP-D<br/>members · recipes · invites<br/>(built, not switched on)"]
    FTA["project tonys-recipes-test — TEST<br/>Auth + Firestore (separate data)"]
    OAUTH["OAuth clients — allowed<br/>…/__/auth/handler addresses"]
  end

  GM["✉️ Gmail — send a recipe<br/>(each person's own account)"]
  GHAPI["GitHub API — whatsapp/ folder<br/>(not on the work iPhone)"]

