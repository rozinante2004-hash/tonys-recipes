rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Tony's Recipes — Firestore security rules (canonical copy, 5.5)
//
// This file is the source of truth. The app fetches it at runtime (⚙️ Settings →
// 👥 Family Access → Show rules) and substitutes the three placeholders below
// with the current member list before showing you what to paste into the
// Firebase console. Edit the structure HERE, not in index.html.
//
// The READ / WRITE / ADMIN placeholders below are filled in with the member
// list. (Named without braces here on purpose — substitution is a blind text
// replace, so a literal token in a comment would be swapped too.) The owner is
// always in all three, so you cannot lock yourself out.
//
// Apply: Firebase console → Firestore Database → Rules → paste → Publish.
// By hand on purpose — a bad rules push locks every device out at once.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared recipe collection — family access. Holds:
    //   recipe_<id>  one photo-free document per recipe          (5.4, v28.0+)
    //   meta         { nextId, ids, schema } for the above       (5.4, v28.0+)
    //   photo_<id>   one document per recipe photo
    //   chat_<slug>, chatpart_<slug>_<n>   synced WhatsApp exports    (5f.8)
    //   access       the member list itself
    // The legacy single `recipes` document was deleted by hand on 15 Aug 2026
    // and its reading code removed in app v32.2. Nothing refers to it any more.
    //   i18n_<lang>  shared interface translations                  (v36.31)
    // All are top-level documents with no subcollections, so one `{docId}`
    // segment covers them (v36.59; it was `{document=**}` until then).
    // v36.59 — one segment, `{docId}`, not `{document=**}`: `shared` holds only
    // top-level documents, and naming the document is what lets the rule below
    // tell the two admin-only ones apart. (Rules are OR'd, so a narrower match
    // cannot take a permission back — the exception has to live in this one.)
    match /shared/{docId} {
      // v36.88 — the interface TRANSLATIONS (i18n_*) may be read by anyone,
      // signed in or not: they are the app's own words, not family data, and
      // every copy of the app (the test copy, the public one) takes its
      // languages from here. One document at a time — never a listing — and
      // nothing else in `shared` is opened by this line.
      allow get: if docId.matches('i18n_.*');

      // Read: owner + all members — with a CONFIRMED address (v37.03). Once
      // an account can be made with any address and a password, an address
      // on this list proves nothing until its owner has confirmed it; Google
      // addresses always are, so nothing changes for anyone signed in today.
      allow read: if request.auth != null && confirmed() &&
        request.auth.token.email in [{{READ}}];

      // Create + update: owner + write/admin members — EXCEPT the documents
      // that change what everybody else sees. `access` is the member list and
      // `i18n_*` are the shared interface translations; the app only offers
      // editing them to admins, and now the database agrees.
      // NOT `write`. In Firestore rules `write` expands to create + update +
      // DELETE, and allow rules are OR'd, so granting `write` here would hand
      // every write-role member deletion as well and make the `allow delete`
      // below decorative.
      allow create, update: if request.auth != null && confirmed() && (
        request.auth.token.email in [{{ADMIN}}] ||
        (request.auth.token.email in [{{WRITE}}] && !adminOnlyDoc(docId)));

      // Delete: owner + admin members only. This genuinely restricts.
      // Consequence worth knowing: a write-role member deleting a recipe removes
      // it from their own device but cannot remove the cloud documents, so it
      // reappears on their next sync. The app says so plainly rather than
      // letting it look like a bug — see flushCloudDeletes.
      allow delete: if request.auth != null && confirmed() &&
        request.auth.token.email in [{{ADMIN}}];
    }
    function confirmed() { return request.auth.token.email_verified == true; }
    function adminOnlyDoc(id) {
      return id == 'access' || id.matches('i18n_.*');
    }

    // ═══ HOUSEHOLDS (WP-D, v36.86) ═══════════════════════════════════════════
    // Added ALONGSIDE the rules above, never instead of them: every path below
    // is new, so publishing this changes nothing for the app as it runs today.
    // It is what the move into households (Family Access → 🏠) writes to, and
    // what the app reads once it runs in the household layout.
    //
    //   households/{hid}                    { name, ownerUid, createdAt }
    //   households/{hid}/members/{uid}      { uid, role, email, name?, joinedAt, invite? }
    //   households/{hid}/recipes/{id}       one recipe each (today: shared/recipe_<id>)
    //   households/{hid}/photos/{id}        one photo each  (today: shared/photo_<id>)
    //   households/{hid}/chats/{id}         WhatsApp chats  (today: shared/chat_*)
    //   households/{hid}/state/{doc}        meta, backups   (today: shared/meta, shared/backups)
    //   pending/{hid}:{email}               { hid, email, role } — a place kept for an
    //                                         e-mail, claimed on first sign-in (how
    //                                         the family's members arrive)
    //   invites/{code}                      { hid, role, createdBy, expiresAt } — the
    //                                         code is the secret (random, long)
    //   households/{hid}/links/{other}      { hid, name, code, at } — a linked household (v37.53)
    //   homes/{uid}                         { hid, at } — the household a person looks from
    //   linkRequests/{id}                   asking to link (v37.53, below)
    //   households/{hid}/requestLog/{other} what became of a request, and who is blocked (v37.80)
    //   linkTalk/{a}_{b}/messages/{id}      two households talking about a link (v37.81)
    //   households/{hid}/talk/{id}          the household talking among itself: to everyone, or one person (v38.78)
    //   households/{hid}/talkIds/{id}       the same ids, nothing else — for deleting the household (v38.78)
    //   i18n/{lang}                         interface translations, for EVERY household
    //   users/{uid}/…                       each person's own, and nobody else's
    //
    // Roles, lowest to highest: viewer · editor · admin · owner.
    //   viewer  reads everything in the household
    //   editor  + adds and changes recipes, photos, chats (cannot delete — as today)
    //   admin   + deletes; invites and manages editors and viewers
    //   owner   + manages admins; renames, transfers or deletes the household
    // ─────────────────────────────────────────────────────────────────────────────

    function signedIn() { return request.auth != null; }
    function hh(hid) { return /databases/$(database)/documents/households/$(hid); }
    function memberPath(hid, uid) { return /databases/$(database)/documents/households/$(hid)/members/$(uid); }
    // v37.96 — may newcomers start a household in this copy? `config/founding`
    // { open } — absent means open (the beta, the test copy); the family's copy
    // is closed by its owner (Tony's choice after the security audit).
    function foundingOpen() {
      return !exists(/databases/$(database)/documents/config/founding)
        || get(/databases/$(database)/documents/config/founding).data.get('open', true) == true;
    }
    // v38.69 — Tony, 20 Oct 2026: "The Beta testing should only be possible by invitation-only (unless adding to the
    // tester's household)." The owner's ✉️ Invite testers writes testerInvites/<SHA-256 of the address, lower-case,
    // in hex>; that address, confirmed, may found a household while the copy takes newcomers by invitation only. The
    // address itself is never stored; a forwarded invitation does not let anyone else in.
    function myInviteHash() { return hashing.sha256(myEmail()).toHexString().lower(); }
    function invitedTester() {
      return signedIn() && verified()
        && exists(/databases/$(database)/documents/testerInvites/$(myInviteHash()));
    }
    function isMember(hid) { return signedIn() && exists(memberPath(hid, request.auth.uid)); }
    function myRole(hid) { return get(memberPath(hid, request.auth.uid)).data.role; }
    function rank(r) {
      return r == 'owner' ? 4 : (r == 'admin' ? 3 : (r == 'editor' ? 2 : (r == 'viewer' ? 1 : 0)));
    }
    function atLeast(hid, r) { return isMember(hid) && rank(myRole(hid)) >= rank(r); }
    function validRole(r) { return r in ['owner', 'admin', 'editor', 'viewer']; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verified() { return request.auth.token.email_verified == true; }
    // An invitation for this household and this role, not expired. A missing or
    // empty code is a plain "no", not an evaluation error.
    function validInvite(hid, code, role) {
      let path = /databases/$(database)/documents/invites/$(code);
      return code is string && code.size() > 0 && exists(path)
        && get(path).data.hid == hid && get(path).data.role == role
        && get(path).data.expiresAt > request.time;
    }

    // v37.49 — a household's identifier (MKN-XXXX-XXXX; no O/0, I/1, L) is
    // reserved in /codes in the SAME batch that gives it to the household, so
    // two households can never share one, and it never changes once given.
    function codeFor(hid, c) {
      return c is string && c.matches('MKN-[A-HJKMNP-Z2-9]{4}-[A-HJKMNP-Z2-9]{4}')
        && getAfter(/databases/$(database)/documents/codes/$(c)).data.hid == hid;
    }
    function codeKept(hid) {
      return request.resource.data.get('code', null) == resource.data.get('code', null)
        || (resource.data.get('code', null) == null && codeFor(hid, request.resource.data.get('code', null)));
    }
    function hhKeys() { return ['name', 'ownerUid', 'createdAt', 'code', 'appRequests', 'referredBy', 'features']; }
    // v38.22 — extras the app's owner switches on for ONE household where the copy
    // has them off for everyone (the family's Gmail and WhatsApp in the community
    // copy): `features` = { gmail?, whatsapp? }, true or false. Only he writes it.
    function okFeatures() {
      return request.resource.data.features is map
        && request.resource.data.features.keys().hasOnly(['gmail', 'whatsapp'])
        && request.resource.data.features.get('gmail', false) is bool
        && request.resource.data.features.get('whatsapp', false) is bool;
    }
    // v37.58 — the app's owner (the management app) reads the list of
    // households, their members, links and requests — never their recipes,
    // photos or chats. The APP_ADMINS placeholder, as for translations.
    // v38.23 — Tony: "the only thing that keeps me Admin is my email address … I need to
    // protect myself". His powers now need (1) a sign-in WITH GOOGLE — not an e-mail
    // link or a password, which someone who only got into his mailbox could use — and
    // (2) once he has switched it on (config/security.ownerTwoStep, after setting up an
    // authenticator app), the authenticator's code in that sign-in. The address is
    // checked first, so nobody else's request ever reads config/security.
    function appAdmin() {
      return signedIn() && verified() && myEmail() in [{{APP_ADMINS}}]
        && request.auth.token.firebase.sign_in_provider == 'google.com' && ownerTwoStepOk();
    }
    function secPath() { return /databases/$(database)/documents/config/security; }
    function ownerTwoStepOk() {
      return !exists(secPath()) || get(secPath()).data.get('ownerTwoStep', false) != true
        || request.auth.token.firebase.get('sign_in_second_factor', '') == 'totp';
    }
    // …and what cannot be undone (deleting a household, its extras, who may found
    // one, the switch above) only within 15 minutes of signing in.
    function recentSignIn() { return request.time.toMillis() < request.auth.token.auth_time * 1000 + 900000; }
    // v37.61 — the app's owner deleting a household from the management app:
    // first marked `deleting: true` (only by him, and only that), and ONLY
    // then may he read and remove what is inside it. He never reads the
    // content of a household he is not deleting.
    function beingDeleted(hid) { return appAdmin() && get(hh(hid)).data.get('deleting', false) == true; }
    // v37.58 — which household's 📲 share link brought this one (its
    // identifier), set when it is founded and never changed.
    function okReferredBy() {
      return request.resource.data.get('referredBy', '') is string && request.resource.data.get('referredBy', '').size() <= 20;
    }
    function okAppRequests() { return request.resource.data.get('appRequests', true) is bool; }

    // v37.53 — LINKED HOUSEHOLDS. Two households that agreed to link each keep
    // `households/<hid>/links/<other>` = { hid, name, code, at }, and each one's
    // members read the other's recipes and photos — nothing else, and never
    // write. A rule cannot list a person's households, so the household a
    // person is looking FROM is named in `homes/<uid>` = { hid, at } (written
    // by the app; it counts only while they are a member of it).
    function homePath() { return /databases/$(database)/documents/homes/$(request.auth.uid); }
    function linkPath(hid, other) { return /databases/$(database)/documents/households/$(hid)/links/$(other); }
    function reqPath(id) { return /databases/$(database)/documents/linkRequests/$(id); }
    // Owner or admin of h, and a plain "no" (not an error) when h is missing.
    function adminOf(h) { return h is string && h != '' && atLeast(h, 'admin'); }
    // v37.80 — anyone in h (Tony: everyone in a household sees its requests page).
    function memberOf(h) { return h is string && h != '' && isMember(h); }
    function linkedReader(hid) {
      return signedIn() && exists(homePath())
        && exists(linkPath(hid, get(homePath()).data.hid))
        && isMember(get(homePath()).data.hid);
    }

    match /households/{hid} {
      allow read: if isMember(hid) || appAdmin();
      // Founding a household: you are its owner, and your own owner membership
      // is written in the same batch (so a household never exists ownerless).
      // v37.95 (security audit) — a household's id is letters and digits (the
      // app's own are Firestore's 20-character ids): it travels to other
      // households in link requests and conversations, and must never carry a quote.
      allow create: if signedIn()
        && hid.matches('^[A-Za-z0-9]{1,64}$')
        && (foundingOpen() || appAdmin() || invitedTester())   // v37.96 — by invitation only, when closed (v38.69: or invited)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(hhKeys())
        && !('features' in request.resource.data)               // v38.22 — never set by whoever founds it
        && (request.resource.data.get('code', null) == null || codeFor(hid, request.resource.data.code))
        && okAppRequests() && okReferredBy()
        && getAfter(memberPath(hid, request.auth.uid)).data.role == 'owner';
      // Renaming, its identifier (once) and whether it takes link requests
      // through the app: owner or admin. Handing it over: the owner only, to a
      // member who is an owner after the same batch.
      allow update: if request.resource.data.keys().hasOnly(hhKeys())
        && request.resource.data.createdAt == resource.data.createdAt
        && codeKept(hid) && okAppRequests()
        && request.resource.data.get('referredBy', null) == resource.data.get('referredBy', null)
        && request.resource.data.get('features', null) == resource.data.get('features', null)   // v38.22
        && ( (atLeast(hid, 'admin') && request.resource.data.ownerUid == resource.data.ownerUid)
          || (resource.data.ownerUid == request.auth.uid
              && getAfter(memberPath(hid, request.resource.data.ownerUid)).data.role == 'owner') );
      allow delete: if resource.data.ownerUid == request.auth.uid
        || (appAdmin() && resource.data.get('deleting', false) == true);
      allow update: if appAdmin() && recentSignIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting'])
        && request.resource.data.deleting == true;
      allow update: if appAdmin() && recentSignIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['features'])
        && okFeatures();

      match /members/{uid} {
        allow read: if isMember(hid) || appAdmin();
        // Joining. Three ways, and each can only make YOU a member:
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'role', 'email', 'name', 'joinedAt', 'invite'])
          && validRole(request.resource.data.role)
          && (
            // 1. founding the household (the batch that creates it)
            (request.resource.data.role == 'owner'
              && getAfter(hh(hid)).data.ownerUid == request.auth.uid
              && !exists(hh(hid)))
            // 2. an invitation for this household, for this role, not expired —
            //    and the household still there (v36.99: an invitation outlives
            //    a deleted household, since invitations cannot be listed)
            //    v37.13 — Read only: a link can be passed on, so it never
            //    grants writing (older links for more no longer work)
            || (request.resource.data.role == 'viewer' && exists(hh(hid))
              && validInvite(hid, request.resource.data.get('invite', ''), request.resource.data.role))
            // 3. a place kept for your (verified) e-mail — how the family's
            //    members arrive at migration, before anyone knows their uid
            || (request.resource.data.role != 'owner' && verified() && exists(hh(hid))
              && exists(/databases/$(database)/documents/pending/$(hid + ':' + myEmail()))
              && get(/databases/$(database)/documents/pending/$(hid + ':' + myEmail())).data.role == request.resource.data.role)
          );
        // Changing a role. The owner may change anyone's (that is how ownership
        // is handed over); an admin only editors' and viewers', and only to
        // editor or viewer. Nobody changes the uid or the e-mail on file.
        // v37.58 — anyone may note when they last opened the app (`lastSeen`,
        // a number), on their own membership and nothing else of it.
        // v37.83 — …and that they agreed to the terms (`termsAt`, `termsVersion`).
        allow update: if signedIn() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'termsAt', 'termsVersion'])
          && request.resource.data.get('lastSeen', 0) is number
          && request.resource.data.get('termsAt', 0) is number
          && request.resource.data.get('termsVersion', '') is string && request.resource.data.get('termsVersion', '').size() <= 20;
        allow update: if request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && validRole(request.resource.data.role)
          && ( (atLeast(hid, 'owner')
                // an owner steps down only once the household is someone else's
                && (uid != request.auth.uid || request.resource.data.role == 'owner'
                    || getAfter(hh(hid)).data.ownerUid != request.auth.uid))
            || (atLeast(hid, 'admin') && uid != request.auth.uid
                && rank(resource.data.role) <= 2 && rank(request.resource.data.role) <= 2) );
        // Leaving (anyone but the owner), or being removed: by the owner, or by
        // an admin if the person is an editor or viewer.
        allow delete: if (uid == request.auth.uid && resource.data.role != 'owner')
          || (uid != request.auth.uid && resource.data.role != 'owner'
              && (atLeast(hid, 'owner') || (atLeast(hid, 'admin') && rank(resource.data.role) <= 2)))
          // v36.99 — the owner's own membership goes in the same batch that
          // deletes the household (never while the household is still there).
          || (uid == request.auth.uid && resource.data.role == 'owner' && !existsAfter(hh(hid)))
          || beingDeleted(hid);
      }

      // The household's content. Editors add and change; only admins delete —
      // the same line today's rules draw between write and delete.
      match /recipes/{id} {
        allow read: if isMember(hid) || linkedReader(hid) || beingDeleted(hid);   // v37.53 — a linked household reads
        allow create, update: if atLeast(hid, 'editor');
        allow delete: if atLeast(hid, 'admin') || beingDeleted(hid);
      }
      match /photos/{id} {
        allow read: if isMember(hid) || linkedReader(hid) || beingDeleted(hid);   // v37.53 — a linked household reads
        allow create, update: if atLeast(hid, 'editor');
        allow delete: if atLeast(hid, 'admin') || beingDeleted(hid);
      }
      match /chats/{id} {
        allow read: if isMember(hid) || beingDeleted(hid);
        allow create, update: if atLeast(hid, 'editor');
        allow delete: if atLeast(hid, 'admin') || beingDeleted(hid);
      }
      // v38.78 — Tony, 21 Oct 2026: "extend the ability to chat with Joined Kitchens to the family members in a
      // household … 2 modes of communication: 1-to-1 and 1-to all (announcements)" — "for members within the same
      // household". `talk/<id>` = { by, name, text, at, to }: `to` 'all' — everyone in the household reads it — or one
      // member's uid — only the two of them. Anyone in it writes (a reader too: talking is not editing recipes),
      // signed with their own uid; nothing is changed afterwards. `talkIds/<id>` = {} — the same id and nothing else,
      // written in the same batch: how the owner's "Delete this household" finds the 1-to-1 messages it may not read.
      match /talk/{id} {
        allow read: if (isMember(hid) && (resource.data.to == 'all' || resource.data.to == request.auth.uid
                                          || resource.data.by == request.auth.uid))
          || beingDeleted(hid);
        allow create: if isMember(hid)
          && request.resource.data.keys().hasOnly(['by', 'name', 'text', 'at', 'to'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.at is int
          && request.resource.data.to is string
          && (request.resource.data.to == 'all'
              || (request.resource.data.to != request.auth.uid && exists(memberPath(hid, request.resource.data.to))))
          && existsAfter(/databases/$(database)/documents/households/$(hid)/talkIds/$(id));
        allow update: if false;
        allow delete: if atLeast(hid, 'owner') || beingDeleted(hid);
      }
      match /talkIds/{id} {
        allow read: if isMember(hid) || beingDeleted(hid);
        allow create: if isMember(hid) && request.resource.data.keys().size() == 0
          && existsAfter(/databases/$(database)/documents/households/$(hid)/talk/$(id))
          && getAfter(/databases/$(database)/documents/households/$(hid)/talk/$(id)).data.by == request.auth.uid;
        allow update: if false;
        allow delete: if atLeast(hid, 'owner') || beingDeleted(hid);
      }
      match /state/{doc} {
        // v38.65 — and a linked household reads the index (`meta`: which recipes there are) and nothing else in state,
        // so its devices read only the recipes that changed and still learn which were deleted.
        allow read: if isMember(hid) || beingDeleted(hid) || (doc == 'meta' && linkedReader(hid));
        allow create, update: if atLeast(hid, 'editor');
        allow delete: if atLeast(hid, 'admin') || beingDeleted(hid);
      }
      // v37.13 — a reader asking to add and change recipes: `requests/<uid>` =
      // { uid, at }. Only for themselves, only while a viewer; the household's
      // admins see them and answer (by changing the role, and removing it).
      match /requests/{uid} {
        allow read: if (signedIn() && uid == request.auth.uid) || atLeast(hid, 'admin') || beingDeleted(hid);
        allow create: if signedIn() && uid == request.auth.uid && isMember(hid)
          && myRole(hid) == 'viewer'
          && request.resource.data.keys().hasOnly(['uid', 'at'])
          && request.resource.data.uid == uid;
        allow update: if false;
        allow delete: if (signedIn() && uid == request.auth.uid) || atLeast(hid, 'admin') || beingDeleted(hid);
      }
      // v37.53 — the households this one is linked with. Both sides are written
      // in the batch that ACCEPTS a request (linkRequests/<from>_<to>, removed in
      // the same batch), by the owner or an admin of the household asked; either
      // side's owner or admin removes the link, both halves at once.
      // v37.80 — what became of the requests to link with this household (and
      // the households it blocked): `requestLog/<other>` = { hid, name, code,
      // status: accepted|rejected|blocked, at, decidedAt, by }. Everyone in it
      // reads it; the owner and admins write it, as they answer.
      match /requestLog/{other} {
        allow read: if isMember(hid) || appAdmin() || beingDeleted(hid);
        allow create, update: if atLeast(hid, 'admin') && other != hid
          && request.resource.data.keys().hasOnly(['hid', 'name', 'code', 'status', 'at', 'decidedAt', 'by', 'note'])
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 500
          && request.resource.data.hid == other
          && request.resource.data.status in ['accepted', 'rejected', 'blocked', 'revoked']
          && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 80
          && request.resource.data.get('code', '') is string && request.resource.data.get('code', '').size() <= 20
          && request.resource.data.by == request.auth.uid;
        allow delete: if atLeast(hid, 'admin') || beingDeleted(hid);
      }
      match /links/{other} {
        allow read: if isMember(hid) || appAdmin();
        allow create: if signedIn() && other != hid
          && request.resource.data.keys().hasOnly(['hid', 'name', 'code', 'at'])
          && request.resource.data.hid == other
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && ( (atLeast(hid, 'admin') && exists(reqPath(other + '_' + hid))
                && get(reqPath(other + '_' + hid)).data.to == hid && !existsAfter(reqPath(other + '_' + hid)))
            || (atLeast(other, 'admin') && exists(reqPath(hid + '_' + other))
                && get(reqPath(hid + '_' + other)).data.to == other && !existsAfter(reqPath(hid + '_' + other))) );
        allow update: if false;
        allow delete: if atLeast(hid, 'admin') || atLeast(other, 'admin') || beingDeleted(hid) || beingDeleted(other);
      }
    }

    // v37.53 — where a person is looking from, for linkedReader: their own, and
    // only a household they are in.
    match /homes/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['hid', 'at'])
        && isMember(request.resource.data.hid);
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    // v37.53 — asking to link. `linkRequests/<id>` =
    //   { from, fromName, fromCode, to?, email?, via, by, at, declined?, toLabel? }
    //   (toLabel: what the sender typed, so they can see whom they asked)
    //   by identifier:  <from>_<to>    via 'code' — only if the household asked
    //                                  takes requests through the app
    //   by e-mail:      <from>:<email> via 'email' — always; whoever signs in
    //                                  with that (confirmed) address passes it
    //                                  on to their household as <from>_<to>
    // Sent by the owner or an admin, under their household's real name and
    // identifier. The household asked sees it (its owner and admins); a
    // refusal is only marked, so the sender never sees "rejected".
    function lrWellFormed() {
      return request.resource.data.keys().hasOnly(['from', 'fromName', 'fromCode', 'to', 'email', 'via', 'by', 'at', 'declined', 'toLabel', 'note'])
        // v37.81 — an optional note with the request (Tony).
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 500
        && request.resource.data.get('declined', false) == false
        && request.resource.data.get('toLabel', '') is string && request.resource.data.get('toLabel', '').size() <= 120;
    }
    // Asking: under the asking household's real name and identifier, as they are now.
    function lrAsNow() {
      return request.resource.data.fromName == get(hh(request.resource.data.from)).data.name
        && request.resource.data.get('fromCode', '') == get(hh(request.resource.data.from)).data.get('code', '');
    }
    // 1. by identifier, from the asking household's owner or an admin
    function lrByCode(id) {
      return request.resource.data.via == 'code' && request.resource.data.by == request.auth.uid
        && id == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.from != request.resource.data.to
        && !('email' in request.resource.data)
        && atLeast(request.resource.data.from, 'admin')
        && exists(hh(request.resource.data.to))
        && get(hh(request.resource.data.to)).data.get('appRequests', true) == true
        && !exists(linkPath(request.resource.data.to, request.resource.data.from));
    }
    // 2. by e-mail, the same people
    function lrByMail(id) {
      return request.resource.data.via == 'email' && request.resource.data.by == request.auth.uid
        && !('to' in request.resource.data)
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && id == request.resource.data.from + ':' + request.resource.data.email
        && atLeast(request.resource.data.from, 'admin');
    }
    // 3. passed on by the person it was sent to, to a household they are in, in the batch that removes the e-mail one.
    //    v38.74 — under the name and identifier the e-mail one carries (checked when it was asked). Tony, 21 Oct 2026:
    //    Tester2 asked Tester1 by e-mail and it never arrived. A copy under the asking kitchen's name of the moment was
    //    refused once that kitchen had been renamed, and the request waited for ever.
    //    ('to' is looked at only once it is there: an error here refused, in the emulator, a request by e-mail that
    //    lrByMail allowed.)
    function lrPassedOn(id) {
      return request.resource.data.via == 'email' && verified()
        && ('to' in request.resource.data) && request.resource.data.to is string
        && id == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.from != request.resource.data.to
        && isMember(request.resource.data.to)
        && !('email' in request.resource.data)
        && exists(lrAsked())
        && get(lrAsked()).data.by == request.resource.data.by
        && get(lrAsked()).data.get('fromName', '') == request.resource.data.fromName
        && get(lrAsked()).data.get('fromCode', '') == request.resource.data.get('fromCode', '')
        && !existsAfter(lrAsked())
        && !exists(linkPath(request.resource.data.to, request.resource.data.from));
    }
    function lrAsked() { return reqPath(request.resource.data.from + ':' + myEmail()); }
    // The household asked has blocked the asking one (its requestLog says so).
    function lrLogPath(to, from) { return /databases/$(database)/documents/households/$(to)/requestLog/$(from); }
    function lrBlocked(to, from) {
      return exists(lrLogPath(to, from)) && get(lrLogPath(to, from)).data.get('status', '') == 'blocked';
    }
    match /linkRequests/{id} {
      allow read: if signedIn() && (
        appAdmin()
        || (verified() && resource.data.get('email', '') == myEmail())
        || memberOf(resource.data.get('from', ''))
        || memberOf(resource.data.get('to', '')));
      allow create: if signedIn() && lrWellFormed()
        && ((lrAsNow() && (lrByCode(id) || lrByMail(id))) || lrPassedOn(id));
      // Refusing: the household asked marks it, and nothing else changes.
      allow update: if (adminOf(resource.data.get('to', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declined'])
          && request.resource.data.declined == true)
        // v38.74 — asked again after a refusal, by identifier or by e-mail (then passed on): the refused request is
        // asked afresh, waiting again. Not after a block: that one stays refused, and the asking side sees "waiting",
        // as ever. (Before, a refused request stood in the way of every later one — and "Unblocked — their next
        // request reaches you again" was not true.)
        || (signedIn() && resource.data.get('declined', false) == true && lrWellFormed()
          && request.resource.data.from == resource.data.from && request.resource.data.to == resource.data.to
          && !lrBlocked(resource.data.to, resource.data.from)
          && ((lrAsNow() && lrByCode(id)) || lrPassedOn(id)));
      // Withdrawn by the sender, answered by the household asked, or passed on
      // (or let go) by the person an e-mail one was sent to.
      allow delete: if signedIn() && (
        appAdmin()
        || (verified() && resource.data.get('email', '') == myEmail())
        || adminOf(resource.data.get('from', ''))
        || adminOf(resource.data.get('to', '')));
    }

    // v37.81 — TALKING ABOUT A LINK (Tony: "a dialog between the requester and
    // the requested … without divulging personal information"). Two households
    // with a request between them, or a link, write to each other:
    // `linkTalk/<a>_<b>/messages/<id>` (a < b) = { from, name, text, at, by },
    // signed with the household's own name (never a person's), by anyone in
    // it; everyone in either household reads it. Nothing is changed or removed
    // afterwards. Blocking hides a household's messages in the app.
    function talkOther(pair, from) { return pair.split('_')[0] == from ? pair.split('_')[1] : pair.split('_')[0]; }
    function talkRelated(pair, from) {
      let other = talkOther(pair, from);
      return existsAfter(reqPath(from + '_' + other)) || exists(reqPath(other + '_' + from))
        || exists(linkPath(from, other));
    }
    match /linkTalk/{pair}/messages/{mid} {
      allow read: if signedIn() && pair.split('_').size() == 2
        && (memberOf(pair.split('_')[0]) || memberOf(pair.split('_')[1]));
      allow create: if signedIn() && pair.split('_').size() == 2
        && pair.split('_')[0] < pair.split('_')[1]
        && request.resource.data.keys().hasOnly(['from', 'name', 'text', 'at', 'by'])
        && request.resource.data.from in pair.split('_')
        && isMember(request.resource.data.from)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.name == get(hh(request.resource.data.from)).data.name
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.at is int
        && talkRelated(pair, request.resource.data.from);
      allow update, delete: if false;
    }

    // A member finding their own memberships across households — the app asks
    // "which households am I in?" with a collection-group query on `members`.
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || appAdmin());
    }
    // v37.58 — every household's links, for the management app.
    match /{path=**}/links/{other} {
      allow read: if appAdmin();
    }

    // v37.49 — the register of household identifiers: `codes/<code>` = { hid, at }.
    // Anyone signed in may look one up (it names a household, nobody's address)
    // — that is how a link request by identifier finds its household. Written
    // only together with the household that takes it, by its owner or an admin;
    // never changed; removed only once its household is gone.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['hid', 'at'])
        && getAfter(hh(request.resource.data.hid)).data.get('code', '') == code
        && (atLeast(request.resource.data.hid, 'admin')
            || getAfter(memberPath(request.resource.data.hid, request.auth.uid)).data.role == 'owner');
      allow update: if false;
      allow delete: if signedIn() && !existsAfter(hh(resource.data.hid));
    }

    // v37.64 — notes to the app's owner from the floating 💬 button (the beta
    // and the test copy). Anyone signed in may leave one, as themselves; only
    // the owner reads them, marks them seen/done, or removes them.
    match /feedback/{id} {
      allow create: if signedIn() && id.matches('^[A-Za-z0-9]{1,64}$')   // v37.95 — shown in the owner's window
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'hid', 'household', 'text', 'shot', 'log',
                                                 'version', 'env', 'device', 'lang', 'where', 'at', 'status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000
        && request.resource.data.get('shot', '') is string && request.resource.data.get('shot', '').size() <= 750000
        && request.resource.data.get('log', '') is string && request.resource.data.get('log', '').size() <= 200000
        && request.resource.data.status == 'new';
      allow read, delete: if appAdmin();
      allow update: if appAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'seen', 'done'];
    }

    // Places kept by e-mail — `pending/<hid>:<email>` = { hid, email, role }.
    // Top-level so the person can FIND theirs (a query on their own address)
    // before they know which household it is. Admins keep places for editors
    // and viewers, the owner for admins too; the person removes their own once
    // claimed.
    match /pending/{key} {
      allow read: if signedIn() && (
        appAdmin() || (verified() && resource.data.email == myEmail()) || atLeast(resource.data.hid, 'admin'));
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['hid', 'email', 'role'])
        && key == request.resource.data.hid + ':' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['admin', 'editor', 'viewer']
        && (atLeast(request.resource.data.hid, 'owner')
            || (atLeast(request.resource.data.hid, 'admin') && request.resource.data.role != 'admin'));
      allow delete: if signedIn() && (
        appAdmin() || (verified() && resource.data.email == myEmail()) || atLeast(resource.data.hid, 'admin'));
    }

    // v37.11 — a word for an address that is NOT confirmed yet: that a place
    // is kept for it — nothing about where or by whom, since the person signed
    // in with it may not own the mailbox. `pendingNotice/<email>` = { email,
    // hid, at }. Only whoever signs in with that address reads it; a
    // household's admins leave it (with their places) and may remove it.
    match /pendingNotice/{email} {
      allow get: if signedIn() && request.auth.token.email != null && email == myEmail();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['email', 'hid', 'at'])
        && request.resource.data.email == email
        && atLeast(request.resource.data.hid, 'admin');
      allow delete: if signedIn() && ((request.auth.token.email != null && email == myEmail())
        || atLeast(resource.data.hid, 'admin'));
    }

    // Invitations. Anyone signed in who HAS the code may read it (that is how
    // it is accepted); it cannot be listed. Owners and admins invite — and
    // since v37.13 only as viewers: writing is asked for and given per person.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['hid', 'role', 'createdBy', 'expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.role == 'viewer'           // v37.13 — links only let people read
        && request.resource.data.expiresAt is timestamp
        && atLeast(request.resource.data.hid, 'admin');
      allow delete: if signedIn() && atLeast(resource.data.hid, 'admin');
    }

    // v38.69 — the owner's tester invitations (see invitedTester): only he lists, writes and removes them; anyone
    // signed in may look up the one for their OWN address (the app asks before offering "Start my own collection").
    match /testerInvites/{h} {
      allow get: if signedIn() && verified() && h == myInviteHash();
      allow read: if appAdmin();
      allow create, update: if appAdmin() && h.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['at', 'by'])
        && request.resource.data.at is int && request.resource.data.by is string;
      allow delete: if appAdmin();
    }

    // v37.96 — the copy's own settings, chosen by the app's owner: `founding`
    // { open, by, at } (see foundingOpen). Anyone signed in reads them (the app
    // says "by invitation only" before trying); only the owner writes.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if appAdmin() && recentSignIn() && doc == 'founding'
        && request.resource.data.keys().hasOnly(['open', 'by', 'at'])
        && request.resource.data.open is bool;
      // v38.23 — the owner's two-step switch: turned ON only from a sign-in that used
      // the authenticator (so it can never lock him out), and off only by him with it.
      allow write: if appAdmin() && recentSignIn() && doc == 'security'
        && request.resource.data.keys().hasOnly(['ownerTwoStep', 'by', 'at'])
        && request.resource.data.ownerTwoStep is bool
        && (request.resource.data.ownerTwoStep == false
            || request.auth.token.firebase.get('sign_in_second_factor', '') == 'totp');
    }

    // Interface translations: one copy for everyone, so no household pays to
    // translate what another already has. Written by the app's own admins —
    // the APP_ADMINS placeholder is filled in exactly as the member lists are.
    match /i18n/{lang} {
      allow get: if true;            // public, as in `shared` (v36.88)
      allow list: if signedIn();
      allow write: if appAdmin();   // v38.23 — the same protected check as everywhere
    }


    // Per-person documents (owner only): legacy data from before the collection
    // became shared, and a person's own settings — `prefs/legal` (the kitchen
    // rules they agreed to, v37.83) and `prefs/offers` (v37.69). v37.95
    // (security audit): anything else written here was anyone's free storage on
    // the project's bill, so only those named settings may be written, and small.
    match /users/{userId}/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/prefs/{pref} {
      allow create, update: if request.auth != null && request.auth.uid == userId
        && pref in ['legal', 'offers', 'ui']
        && request.resource.data.keys().size() <= 40;
    }
  }
}
