rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Tony's Recipes — Firestore security rules (canonical copy, 5.5)
//
// This file is the source of truth. The app fetches it at runtime (⚙️ Settings →
// 👥 Family Access → Show rules) and substitutes the three placeholders below
// with the current member list before showing you what to paste into the
// Firebase console. Edit the structure HERE, not in index.html.
//
// The READ / WRITE / ADMIN placeholders below are filled in with the member
// list. (Named without braces here on purpose — substitution is a blind text
// replace, so a literal token in a comment would be swapped too.) The owner is
// always in all three, so you cannot lock yourself out.
//
// Apply: Firebase console → Firestore Database → Rules → paste → Publish.
// By hand on purpose — a bad rules push locks every device out at once.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared recipe collection — family access. Holds:
    //   recipe_<id>  one photo-free document per recipe          (5.4, v28.0+)
    //   meta         { nextId, ids, schema } for the above       (5.4, v28.0+)
    //   photo_<id>   one document per recipe photo
    //   recipes      the legacy single document — no longer written from v28.1,
    //                still READ once per load to catch a device left on v27.9
    //   access       the member list itself
    // The {document=**} wildcard already covers all of these, so 5.4 needed no
    // rules change. Verified rather than assumed, per PLAN-5.4 §5.
    match /shared/{document=**} {
      // Read: owner + all members
      allow read: if request.auth != null &&
        request.auth.token.email in [{{READ}}];

      // Create + update: owner + write/admin members.
      // NOT `write`. In Firestore rules `write` expands to create + update +
      // DELETE, and allow rules are OR'd, so granting `write` here would hand
      // every write-role member deletion as well and make the `allow delete`
      // below decorative. Spelling out create and update is what makes the
      // delete rule mean something.
      allow create, update: if request.auth != null &&
        request.auth.token.email in [{{WRITE}}];

      // Delete: owner + admin members only. This now genuinely restricts.
      // Consequence worth knowing: a write-role member deleting a recipe removes
      // it from their own device but cannot remove the cloud documents, so it
      // reappears on their next sync. The app says so plainly rather than
      // letting it look like a bug — see flushCloudDeletes.
      allow delete: if request.auth != null &&
        request.auth.token.email in [{{ADMIN}}];
    }

    // Legacy per-user documents (owner only). Kept for data written before the
    // collection became shared; nothing writes here any more.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
